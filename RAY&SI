local function addButton(text, callback)
    local button = create("TextButton", {
        Size = UDim2.new(1, -5, 0, 38),
        BackgroundColor3 = PANEL,
        Text = text,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamSemibold,
        TextSize = 14,
        ZIndex = 4
    }, content)

    corner(button, 8)
    outline(button)

    button.Activated:Connect(callback)
    return button
end

