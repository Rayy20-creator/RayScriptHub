-- 8. MEMUAT SCRIPT RAY&SI HUB
local function executeUserScript()
    statusLabel.Text = "Sedang memuat RAY&SI HUB..."
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)

    task.spawn(function()
        local success, err = pcall(function()
            local url = "https://raw.githubusercontent.com/Rayy20-creator/RayScriptHub/refs/heads/Pages/RAY%26SI%20HUB"

            local source = game:HttpGet(url)
            assert(#source > 0, "File Lua kosong")

            local scriptFunction, compileError = loadstring(source)
            assert(scriptFunction, compileError or "Gagal membaca kode Lua")

            screenGui:Destroy()
            scriptFunction()
        end)

        if not success then
            warn("RAY&SI HUB Error: " .. tostring(err))

            if screenGui.Parent then
                statusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
                statusLabel.Text = "Gagal memuat: " .. tostring(err)
            end
        end
    end)
end

-- 9. VERIFIKASI KEY
verifyBtn.MouseButton1Click:Connect(function()
    local inputedKey = keyInput.Text

    if keyList[inputedKey] then
        statusLabel.Text = "Key benar! Memuat RAY&SI HUB..."
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
        executeUserScript()
    else
        statusLabel.Text = "Key salah! Coba lagi."
        statusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
    end
end)

