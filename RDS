tabs.Size = UDim2.new(1, -20, 0, 38)
tabs.Position = UDim2.new(0, 10, 0, 50)
tabs.BackgroundTransparency = 1
tabs.Parent = main

local function createButton(parent, text, pos, size)
    local b = Instance.new("TextButton")
    b.Size = size or UDim2.new(1, 0, 0, 38)
    b.Position = pos or UDim2.new()
    b.BackgroundColor3 = Color3.fromRGB(35, 32, 47)
    b.TextColor3 = Color3.fromRGB(240, 240, 245)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 13
    b.Text = text
    b.AutoButtonColor = true
    b.Parent = parent

    Instance.new("UICorner", b).CornerRadius =
        UDim.new(0, 7)

    return b
end

local mainTab = createButton(
    tabs, "MAIN", UDim2.new(),
    UDim2.new(0.49, 0, 1, 0)
)

local settingsTab = createButton(
    tabs, "PENGATURAN",
    UDim2.new(0.51, 0, 0, 0),
    UDim2.new(0.49, 0, 1, 0)
)

local content = Instance.new("ScrollingFrame")
content.Size = UDim2.new(1, -20, 1, -105)
content.Position = UDim2.new(0, 10, 0, 95)
content.BackgroundTransparency = 1
content.BorderSizePixel = 0
content.ScrollBarThickness = 4
content.CanvasSize = UDim2.new(0, 0, 0, 0)
content.Parent = main

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = content

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(
    function()
        content.CanvasSize = UDim2.new(
            0, 0, 0, layout.AbsoluteContentSize.Y + 8
        )
    end
)

local function clear()
    for _, v in ipairs(content:GetChildren()) do
        if v:IsA("TextButton") or v:IsA("TextLabel") then
            v:Destroy()
        end
    end
end

local function label(text)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -4, 0, 28)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(190, 175, 215)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = content
    return l
end

local function showMain()
    clear()

    label("MOVEMENT")

    createButton(content, "Fly", nil).MouseButton1Click:Connect(
        function()
            warn("Fly membutuhkan implementasi yang didukung game.")
        end
    )

    createButton(content, "Noclip", nil).MouseButton1Click:Connect(
        function()
            warn("Noclip membutuhkan implementasi yang didukung game.")
        end
    )

    label("TELEPORT TO PLAYER")
    createButton(content, "Refresh Player List", nil).MouseButton1Click:Connect(
        function()
            showMain()
        end
    )

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            createButton(content, target.Name, nil).MouseButton1Click:Connect(
                function()
                    warn("Teleport tidak tersedia tanpa dukungan game.")
                end
            )
        end
    end
end

local function showSettings()
    clear()

    label("PENGATURAN")

    createButton(content, "Save Settings", nil).MouseButton1Click:Connect(
        function()
            warn("Pengaturan tersimpan hanya jika penyimpanan tersedia.")
        end
    )

    createButton(content, "Load Settings", nil).MouseButton1Click:Connect(
        function()
            warn("Pemuatan pengaturan belum dikonfigurasi.")
        end
    )

    createButton(content, "Reset Settings", nil).MouseButton1Click:Connect(
        function()
            showSettings()
        end
    )

    createButton(content, "Auto Execute", nil).MouseButton1Click:Connect(
        function()
            warn("Auto Execute bergantung pada lingkungan yang digunakan.")
        end
    )

    createButton(content, "Server Hop", nil).MouseButton1Click:Connect(
        function()
            warn("Server Hop memerlukan akses server yang didukung.")
        end
    )

    label("RAY&SI HUB | GUI VERSION 1.0")
end

mainTab.MouseButton1Click:Connect(showMain)
settingsTab.MouseButton1Click:Connect(showSettings)

close.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

showMain()
